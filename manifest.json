{
  "manifest_version": 3,
  "name": "AWS SSO Launcher",
  "version": "1.0.0",
  "description": "Search your AWS IAM Identity Center accounts and permission sets, and keep an eye on your AWS console sessions.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "cookies"],
  "host_permissions": [
    "https://*.awsapps.com/*",
    "https://*.aws.amazon.com/*",
    "https://*.amazonaws.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "AWS SSO Launcher", "default_popup": "launcher.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" } }
  }
}
