{
  "manifest_version": 3,
  "name": "AWS SSO Launcher",
  "version": "1.0.0",
  "description": "Search your AWS IAM Identity Center accounts and permission sets, and keep an eye on your AWS console sessions.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "cookies"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "https://*.awsapps.com/*",
    "https://*.aws.amazon.com/*",
    "https://*.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AWS SSO Launcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "launcher.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      }
    }
  }
}
